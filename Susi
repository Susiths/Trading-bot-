from flask import Flask, request
import requests
import os

app = Flask(__name__)

TELEGRAM_BOT_TOKEN = 8702205500:AAHqE16RX6MUgTRKFdwH4qxdb_DUuYAwWIg
TELEGRAM_CHAT_ID = 8702205500

@app.route('/webhook', methods=['POST'])
def webhook():
    data = request.json
    if data:
        message = data.get('message', 'TradingView Signal Received!')
        
        telegram_url = f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/sendMessage"
        payload = {
            "chat_id": TELEGRAM_CHAT_ID,
            "text": message,
            "parse_mode": "Markdown"
        }
        
        response = requests.post(telegram_url, json=payload)
        if response.status_code == 200:
            return "Success", 200
        else:
            return "Telegram Error", 400
            
    return "No Data", 400

if __name__ == '__main__':
    port = int(os.environ.get("PORT", 5000))
    app.run(host='0.0.0.0', port=port)
